      "text": "· 忽略动词搭配。",
      "sourcePage": 64,
      "sourceIndex": 1770
    },
    {
      "type": "paragraph",
      "text": "CHECK - Final check",
      "sourcePage": 64,
      "sourceIndex": 1771
    },
    {
